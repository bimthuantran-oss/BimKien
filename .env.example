# PostgreSQL — dùng docker/docker-compose.yml cho local dev
DATABASE_URL="postgresql://bimportal:bimportal@localhost:5433/bimportal?schema=public"
# Ket noi truc tiep (khong qua pooler) dung cho migrate — tren Neon dung
# DATABASE_URL_UNPOOLED co san; local dev de giong DATABASE_URL la duoc
DATABASE_URL_UNPOOLED="postgresql://bimportal:bimportal@localhost:5433/bimportal?schema=public"

# NextAuth — tạo secret bằng: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Hiển thị công khai
NEXT_PUBLIC_SITE_NAME="BIMKien"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
